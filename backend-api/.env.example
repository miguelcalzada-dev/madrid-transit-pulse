# ============================================================
# .env.example - Variables de entorno del Backend API
# Madrid Transit Pulse
# ============================================================
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas el .env real al control de versiones.
# ============================================================

# Servidor
PORT=3001
NODE_ENV=development

# Modo de datos:
#   true  -> simulacion en memoria (mockDb). No requiere MongoDB.
#   false -> MongoDB real (requiere MONGO_URI).
# Si MONGO_URI esta vacio o contiene PLACEHOLDER, se fuerza el modo mock.
USE_MOCK=true

# MongoDB (solo necesario con USE_MOCK=false)
MONGO_URI=
MONGO_DB_NAME=madrid_transit

# CORS: lista blanca explicita de origenes, separados por coma.
# No se admiten comodines por subdominio (*.vercel.app, *.railway.app...).
# En produccion debe incluir el origen exacto desde el que se consume la API,
# que en el portal es https://miguelcalzada.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://miguelcalzada.com,https://www.miguelcalzada.com

# Polling de alertas para WebSocket (milisegundos)
# En produccion con MongoDB real conviene usar Change Streams (requiere replica set)
ALERTS_POLL_INTERVAL_MS=5000

# Limite de alertas devueltas por el endpoint /api/status
ALERTS_LIMIT=50

# Rate limiting: max peticiones por IP en la ventana
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# GTFS Estatico: URL para auto-descarga de horarios (vacio = usar archivos locales)
# Ej: GTFS_STATIC_URL=https://crtm.maps.arcgis.com/.../gtfs.zip
GTFS_STATIC_URL=
# Cada cuantas horas refrescar el GTFS estatico (0 = desactivado)
GTFS_STATIC_UPDATE_HOURS=24

# Propagacion de retrasos: factor de decaimiento por parada (0-1)
# 0.85 = el retraso se reduce ~15% en cada parada
DELAY_DAMPING_FACTOR=0.85

# Logging
LOG_LEVEL=debug
